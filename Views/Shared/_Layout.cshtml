<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1014" />
    <title>@ViewData["Title"] - DevPulse</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DevPulse.App.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="topbar-inner" aria-label="Navegación principal">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">D</span> DevPulse<span class="brand-period">.</span>
            </a>
            <div class="topbar-links">
                <a class="nav-link" asp-area="" asp-controller="AiSettings" asp-action="Index">Configurar IA</a>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </div>
        </nav>
    </header>
    <div class="page-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>&copy; 2026 DevPulse · Inteligencia para tus logs</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
